&pinctrl {
	uart0_default: uart0_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 8)>, /* Change 6/8 to your TX/RX pins */
			        <NRF_PSEL(UART_RX, 0, 6)>;
		};
	};

	uart0_sleep: uart0_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 8)>,
			        <NRF_PSEL(UART_RX, 0, 6)>;
			low-power-enable;
		};
	};

	spi0_default: spi0_default {
            group1 {
                    psels = <NRF_PSEL(SPIM_SCK, 0, 26)>, /* Dummy pin for SCK */
                            <NRF_PSEL(SPIM_MOSI, 0, 25)>; /* WS2812B Data Line */
            };
    };
};
